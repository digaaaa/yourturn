{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "server": { "type": "string" },
    "location": { "type": "string" },
    "databaseNames": { "type": "array" }
  },
  "resources": [
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2023-08-01",
      "name": "[format('{0}/{1}', parameters('server'), parameters('databaseNames')[copyIndex()])]",
      "location": "[parameters('location')]",
      "copy": { "name": "sqlDatabases", "count": "[length(parameters('databaseNames'))]" },
      "sku": {
        "name": "GP_S_Gen5",
        "tier": "GeneralPurpose",
        "family": "Gen5",
        "capacity": 1
      },
      "properties": {
        "createMode": "Default",
        "minCapacity": 0.5,
        "requestedBackupStorageRedundancy": "Local",
        "useFreeLimit": true,
        "freeLimitExhaustionBehavior": "AutoPause"
      }
    }
  ]
}
